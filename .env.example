# Copy to .env and fill in real values. .env is gitignored — this file is not, and holds no secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Optional — defaults to Resend's sandbox sender, which only delivers to your
# own Resend account email until you verify a sending domain. Set this once
# you have a verified domain, e.g. RESEND_FROM_EMAIL="Koya Talent <hello@yourdomain.com>"
RESEND_FROM_EMAIL=
# Used to build the {{proposal_link}} in the client email. vercel dev serves
# both the app and /api on this same port — not Vite's default 5173.
BASE_URL=http://localhost:3000
